{
  "name": "Life OS",
  "short_name": "Life OS",
  "description": "A personal productivity dashboard for work, school, fitness, learning, and business.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0a0a0c",
  "theme_color": "#0a0a0c",
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Capture",
      "short_name": "Capture",
      "description": "Fast entry for a task, distraction, worry, or note — no dashboard to load first.",
      "url": "/capture",
      "icons": [
        {
          "src": "/icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Import to read",
      "short_name": "Read",
      "description": "Paste, link or upload something to read in the focus reader.",
      "url": "/read/import",
      "icons": [
        {
          "src": "/icon-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/api/reader/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "application/epub+zip",
            "text/plain",
            "text/markdown",
            ".pdf",
            ".epub",
            ".txt",
            ".md"
          ]
        }
      ]
    }
  }
}
